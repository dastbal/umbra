{
  "name": "@dastbal/nestjs-ai-agent",
  "version": "1.5.0",
  "description": "Autonomous AI Agent for NestJS - Principal Software Engineer Level with RAG and SQLite persistence",
  "author": "David Balladares",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "agent": "dist/bin/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "gen": "ts-node src/bin/cli.ts classic",
    "agent": "ts-node src/bin/cli.ts",
    "start:dev": "ts-node src/bin/cli.ts",
    "prepublishOnly": "npm run build",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:cov": "jest --coverage",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix"
  },
  "dependencies": {
    "@langchain/core": "^1.1.48",
    "@langchain/google-vertexai": "^2.1.31",
    "@langchain/langgraph": "^1.3.5",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.1",
    "@langchain/langgraph-supervisor": "^1.0.4",
    "@langchain/ollama": "^1.2.7",
    "better-sqlite3": "^12.10.0",
    "chalk": "^4.1.2",
    "commander": "^14.0.2",
    "deepagents": "^1.10.2",
    "dotenv": "^17.4.2",
    "langchain": "^1.4.4",
    "langsmith": "^0.7.5",
    "ora": "^5.4.1",
    "sqlite3": "^5.1.7",
    "ts-morph": "^28.0.0",
    "uuid": "^13.0.2",
    "zod": "^4.4.3"
  },
