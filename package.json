{
  "name": "@dastbal/umbra",
  "version": "2.2.9",
  "description": "Umbra is a secure autonomous engineering orchestrator for NestJS projects.",
  "author": "David Balladares",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dastbal/umbra.git"
  },
  "bugs": {
    "url": "https://github.com/dastbal/umbra/issues"
  },
  "homepage": "https://github.com/dastbal/umbra#readme",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "umbra": "dist/bin/cli.js"
  },
  "files": [
    "dist",
    "skills/*.md",
    ".agents/skills/umbra-tool-usage/**",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.build.json",
    "gen": "ts-node src/bin/cli.ts classic",
    "umbra": "ts-node src/bin/cli.ts",
    "start:dev": "ts-node src/bin/cli.ts",
    "prepublishOnly": "npm run build",
    "type-check": "tsc --noEmit",
    "test": "jest --runInBand",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=integration|e2e|contract",
    "test:integration": "jest --runInBand --testPathPatterns=integration",
    "test:contracts": "jest --runInBand --testPathPatterns=contract",
    "test:e2e": "jest --runInBand --testPathPatterns=e2e",
    "test:cov": "jest --coverage",
    "lint": "node node_modules/typescript/bin/tsc --noEmit",
    "bench:retrieval": "node scripts/bench-retrieval.mjs",
    "bench:fts-only": "node scripts/bench-fts-only.mjs",
    "bench:graph": "node scripts/bench-graph-recall.mjs",
    "bench:fixture": "node scripts/build-retrieval-fixture.mjs",
    "test:gate": "jest --runInBand src/core/rag/retrieval-gate.spec.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@anthropic-ai/vertex-sdk": "0.19.6",
    "@langchain/anthropic": "1.3.26",
    "@langchain/core": "1.1.48",
    "@langchain/google-vertexai": "2.1.31",
    "@langchain/langgraph": "1.3.5",
    "@langchain/langgraph-checkpoint-sqlite": "^1.0.1",
    "@langchain/langgraph-supervisor": "^1.0.4",
    "@langchain/ollama": "^1.2.7",
    "better-sqlite3": "^12.10.0",
    "chalk": "^4.1.2",
    "commander": "^14.0.2",
    "deepagents": "1.10.2",
    "dotenv": "^17.4.2",
    "js-tiktoken": "^1.0.21",
    "langchain": "1.4.4",
    "langsmith": "^0.7.5",
    "ora": "^5.4.1",
    "sqlite-vec": "^0.1.9",
    "ts-morph": "^28.0.0",
    "typescript": "5.9.3",
    "uuid": "^14.0.2",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.0.0 || ^11.0.0",
    "reflect-metadata": "^0.1.13 || ^0.2.0"
  },
  "devDependencies": {
    "@langchain/langgraph-cli": "^1.2.4",
    "@nestjs/common": "^11.1.24",
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.41",
    "@types/uuid": "^10.0.0",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2"
  }
}
